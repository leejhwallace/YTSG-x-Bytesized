# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored; this `.env.example` is committed so the repo documents
# what secrets are required.

# Supabase project URL. Find it under
# Dashboard -> Project Settings -> API.
SUPABASE_URL=https://txfditoxxdjigplckjcc.supabase.co

# Supabase service_role key (the "secret" key). Find it under
# Dashboard -> Project Settings -> API -> service_role secret.
# IMPORTANT: this key bypasses RLS and must NEVER be sent to the browser.
# Keep it in your server-side `.env` only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the Express port (defaults to 3000).
# PORT=3000
